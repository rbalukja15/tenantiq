# Non-secret configuration for the backend and worker (#24, ADR-0019).
#
# Consumed by base/kustomization.yaml's configMapGenerator, which appends a content hash to the
# ConfigMap name and rewrites every reference to it. That hash is the point: editing a plain
# ConfigMap changes nothing about running pods, so a config change would silently not take effect
# until something unrelated restarted them. A new name is a new spec, so the Deployments roll.
#
# This carries the FULL documented TENANTIQ_* surface, deliberately. docker-compose's `x-backend-env`
# forwards nine of the ~35 variables the settings module reads, so every other documented tunable set
# in `.env` silently does nothing under compose — a knob an operator can set that has no effect is
# worse than one that does not exist. Overlays override individual keys; nothing is dropped.
#
# Anything secret (DATABASE_URL, DJANGO_SECRET_KEY, ANTHROPIC_API_KEY) lives in the `tenantiq-secrets`
# Secret and is never in this repo.

# --- Django -----------------------------------------------------------------------------------
DJANGO_DEBUG=false
# The BFF reaches the API by Service DNS, so that name must be allowed. Overlays append their own.
DJANGO_ALLOWED_HOSTS=tenantiq-backend,tenantiq-backend.svc.cluster.local
MEDIA_ROOT=/app/media

# --- rate limits & quotas (#49, ADR-0011) -----------------------------------------------------
TENANTIQ_THROTTLE_QUERY=30/min
TENANTIQ_THROTTLE_UPLOAD=20/min
TENANTIQ_THROTTLE_READ=120/min
TENANTIQ_THROTTLE_DISCOVERY=60/min
TENANTIQ_QUERY_DAILY_QUOTA=1000
TENANTIQ_QUERY_MONTHLY_QUOTA=0

# --- cost accounting (#17, ADR-0012). USD per million tokens ----------------------------------
TENANTIQ_LLM_PRICE_INPUT_PER_MTOK=5.00
TENANTIQ_LLM_PRICE_OUTPUT_PER_MTOK=25.00

# --- ingestion limits (#47) -------------------------------------------------------------------
TENANTIQ_MAX_UPLOAD_BYTES=26214400
TENANTIQ_INGEST_SOFT_TIME_LIMIT=240
TENANTIQ_INGEST_TIME_LIMIT=300
# The stuck-document sweep (#55, ADR-0023): beat sends it this often, and it fails a PROCESSING
# document unchanged for longer than REAP_AFTER. `migrate` refuses REAP_AFTER under twice the limit.
TENANTIQ_INGEST_REAP_AFTER_SECONDS=1800
TENANTIQ_INGEST_SWEEP_INTERVAL_SECONDS=300
TENANTIQ_MAX_PDF_PAGES=2000
TENANTIQ_MAX_EXTRACTED_CHARS=10000000

# --- chunking & embeddings (ADR-0003/0004) ----------------------------------------------------
# Changing the dimension or the model requires re-embedding the whole corpus (#53, ADR-0020). 1024 is
# the same number in every environment: `voyage-4` and `mxbai-embed-large` both emit it, which is
# what lets one migration history serve dev and prod. TENANTIQ_EMBEDDING_MODEL is the LOCAL model;
# the prod overlay switches the factory to Voyage, where TENANTIQ_VOYAGE_MODEL applies instead.
TENANTIQ_CHUNK_TARGET_TOKENS=800
TENANTIQ_CHUNK_OVERLAP_TOKENS=100
TENANTIQ_EMBEDDING_MODEL=mxbai-embed-large
TENANTIQ_EMBEDDING_DIM=1024
TENANTIQ_EMBED_BATCH_SIZE=64

# --- retrieval (#14, ADR-0007) ----------------------------------------------------------------
TENANTIQ_RETRIEVAL_TOP_K=5
# The floor that lets the product refuse (#88, ADR-0021), measured on mxbai-embed-large, the
# embedder this base runs: the best match for an answerable question scores 0.567 or more, for an
# unanswerable one 0.441 or less (docs/evaluation.md). It does not carry across embedders, so the
# prod overlay sets its own.
TENANTIQ_RETRIEVAL_MIN_SIMILARITY=0.50

# --- generation (#15/#90, ADR-0008) -----------------------------------------------------------
TENANTIQ_LLM_MODEL=claude-opus-4-8
TENANTIQ_LLM_MAX_TOKENS=1024
TENANTIQ_LLM_TIMEOUT_SECONDS=60
TENANTIQ_LLM_OLLAMA_MODEL=llama3.1
TENANTIQ_LLM_OLLAMA_TIMEOUT_SECONDS=300
TENANTIQ_LLM_NUM_CTX=8192
TENANTIQ_LLM_RESPONSE_HEADROOM_TOKENS=512
