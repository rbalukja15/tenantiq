# Copy to `.env.local` for host runs: `cp .env.example .env.local`.
#
# Next reads `.env.local` from *this* directory — it does not read the repo-root `.env` (that one is
# loaded by Django via python-dotenv). Without these two variables `npm run dev` compiles fine and
# then 500s on the first request, because `lib/config.ts` validates them at call time.
#
# `docker compose up` does not need this file: the frontend service sets both variables itself, with
# API_BASE_URL pointing at the in-network hostname rather than localhost.

# Django, as seen from the Next server. Server-side only — never NEXT_PUBLIC_, because under the BFF
# the browser never calls the API directly.
API_BASE_URL=http://localhost:8000

# This app's own public origin: the OIDC redirect_uri, the post-logout URI, and the Origin that every
# state-changing request must carry.
APP_BASE_URL=http://localhost:3000
