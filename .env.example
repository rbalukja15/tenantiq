# Copy to `.env` (`make dev` does this for you). Two consumers (#23):
#   - Host runs (python manage.py ...): the backend loads this file via python-dotenv, so these
#     localhost URLs are what take effect — start the datastores with `docker compose up db redis`.
#   - `docker compose up` (full stack): the app runs *inside* the compose network, so each service
#     overrides the infra hostnames to db/redis/ollama; the secrets/tunables below still apply.
#
# Backend / Django
# The app connects as a NON-superuser role so Postgres row-level security actually enforces
# (ADR-0002). The superuser `tenantiq` is bootstrap-only; `tenantiq_app` is created by
# infra/postgres/init/10-app-role.sql on first DB init.
DATABASE_URL=postgresql://tenantiq_app:tenantiq_app@localhost:5432/tenantiq
REDIS_URL=redis://localhost:6379/0
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ANTHROPIC_API_KEY=

# Per-tenant cost accounting (#17, ADR-0012). USD per *million* tokens, parsed as Decimal (money is
# never a float). Defaults track Claude Opus 4.8 list pricing; retune per deployment/model. The price
# in effect at write time is stored on each usage row, so changing these never rewrites history.
# TENANTIQ_LLM_PRICE_INPUT_PER_MTOK=5.00
# TENANTIQ_LLM_PRICE_OUTPUT_PER_MTOK=25.00

# Per-tenant rate limiting & quotas (#49, ADR-0011). Limits are configuration, not code. Rates are
# per tenant per scope; quotas cap total query volume per tenant per calendar window (0 = unlimited).
# Throttle counters live in the cache — CACHE_URL defaults to REDIS_URL so they are shared across
# workers (a per-process cache would enforce N x the rate under N workers).
# CACHE_URL=redis://localhost:6379/0
# TENANTIQ_THROTTLE_QUERY=30/min
# TENANTIQ_THROTTLE_UPLOAD=20/min
# TENANTIQ_THROTTLE_READ=120/min
# TENANTIQ_QUERY_DAILY_QUOTA=1000
# TENANTIQ_QUERY_MONTHLY_QUOTA=0
# The tenant-discovery endpoint (#18) is reached *before* login, so it has no tenant to key on. It is
# bucketed per requested **slug** — not per client: behind the BFF every discovery request reaches
# Django from the Next server, so a client key would be one global bucket and a single flood would
# deny login to every tenant at once. Sized as a per-tenant damper, hence the higher default.
# TENANTIQ_THROTTLE_DISCOVERY=60/min

# Embeddings (ADR-0004). Local Ollama backend; the model is pulled into the compose `ollama` service.
OLLAMA_BASE_URL=http://localhost:11434
TENANTIQ_EMBEDDING_MODEL=nomic-embed-text

# OIDC: per-tenant issuers are stored in the DB (Tenant.oidc_issuer) and are authoritative.
# This is only a dev bootstrap default pointing at the local Keycloak realm. The hostname is
# `keycloak`, not `localhost`, so that one issuer string works from the browser, the Next server and
# Django alike — see docs/auth-keycloak.md (it needs a /etc/hosts line).
OIDC_ISSUER_URL=http://keycloak:8080/realms/acme

# Keycloak (docker-compose `dev` profile) — local admin console credentials only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend (#18, ADR-0013). Under the BFF the browser never calls Django directly, so there is no
# public API URL to publish (and no CORS to configure).
#
# NOTE: Next does NOT read this file — it reads frontend/.env.local. For a host run
# (`npm run dev`), copy frontend/.env.example to frontend/.env.local. The value below is used only
# by docker-compose, which interpolates it into the frontend service; API_BASE_URL is set there
# directly, because inside the compose network the API is http://backend:8000, not localhost.
APP_BASE_URL=http://localhost:3000
